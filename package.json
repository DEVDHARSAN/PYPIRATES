{
  "name": "pypirates",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm install --prefix client && npm run build --prefix client && prisma generate",
    "build:server": "prisma generate",
    "start": "prisma db push --accept-data-loss --skip-generate && node server/index.js",
    "dev:server": "node server/index.js",
    "seed": "node server/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^5.19.1",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "prisma": "^5.19.1"
  },
  "engines": {
    "node": ">=18"
  }
}
